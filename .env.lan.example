# Smart Brain Agent LAN environment template
# Copy this file to .env and replace CHANGE_ME / LAN_SERVER_IP values.

LAN_SERVER_IP=192.168.1.40

# Domains shown to containers and browsers
PROTOCOL=http
API_DOMAIN=${LAN_SERVER_IP}:8000
APP_DOMAIN=${LAN_SERVER_IP}:3001
NEXT_PUBLIC_API_URL=http://${LAN_SERVER_IP}:8000
NEXT_PUBLIC_APP_URL=http://${LAN_SERVER_IP}:3001
NEXT_PUBLIC_SITE_URL=http://${LAN_SERVER_IP}:3001
NEXT_PUBLIC_SIGNIN_METHODS=email
NEXT_PUBLIC_ENVIRONMENT_TYPE=development
NEXT_PUBLIC_PLAYGROUND=false

# Local Supabase. If you use Supabase CLI with project_id "database",
# these container hostnames match the generated Docker network.
SUPABASE_URL=http://supabase_kong_database:8000
SUPABASE_HOST=supabase_db_database
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=postgres
SUPABASE_SSLMODE=disable
SUPABASE_MAX_POOL_SIZE=10
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_KEY=${SUPABASE_SERVICE_ROLE_KEY}
SUPABASE_JWT_SECRET=CHANGE_ME_SUPABASE_JWT_SECRET
SUPABASE_PROJECT_ID=database

# API/session secrets. Generate long random strings for production.
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_JWT_SECRET
AUTH_COOKIE_SECRET=CHANGE_ME_LONG_RANDOM_COOKIE_SECRET

# ClickHouse / OTLP
CLICKHOUSE_DATABASE=otel_2
CLICKHOUSE_USERNAME=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=password
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_SECURE=false
CLICKHOUSE_ENDPOINT=http://clickhouse:8123

# AI chat/RAG LLM. Leave token empty until you configure a provider.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=http://host.docker.internal:15721
RAG_LLM_MODEL=MiniMax-M3
RAG_RETRIEVAL_VERSION=v1
RAG_EMBEDDING_SERVICE_URL=http://rag-embedding-service:8080
RAG_RERANKER_SERVICE_URL=http://rag-reranker-service:8080
RAG_V2_EMBEDDING_MODEL=BAAI/bge-m3
RAG_V2_EMBEDDING_VERSION=2026-07-21-bge-m3
RAG_V2_EMBED_ON_UPLOAD=false
RAG_V2_FALLBACK_TO_V1=true

# Workday / employee monitor
WORKDAY_COLLECTOR_ENDPOINT=http://${LAN_SERVER_IP}:4318
WORKDAY_ENROLLMENT_TOKEN_DAYS=30

# Optional billing/analytics. Keep empty for LAN trial.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_TOKEN_PRICE_ID=
STRIPE_SPAN_PRICE_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
