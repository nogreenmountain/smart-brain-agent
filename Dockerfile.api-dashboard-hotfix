FROM agentops-api-local:members-category-r52

COPY agentops_local/api/routes/v4/ai_usage.py /app/agentops/api/routes/v4/ai_usage.py

RUN /app/.venv/bin/python -c "from pathlib import Path; path = Path('/app/agentops/api/routes/v4/project_memory.py'); source = path.read_text(); old = 'ORDER BY department.sort_order, department.name, department.id\\n            FOR UPDATE'; new = 'ORDER BY department.sort_order, department.name, department.id\\n            FOR UPDATE OF department'; assert source.count(old) == 1, 'expected reorder lock query once'; path.write_text(source.replace(old, new))"
