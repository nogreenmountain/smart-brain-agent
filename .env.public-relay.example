# SmartBrain public IP relay. Copy these values into .env and replace the IP
# when deploying a different relay host.
PROTOCOL=https
API_DOMAIN=39.105.79.0
APP_DOMAIN=39.105.79.0
NEXT_PUBLIC_API_URL=https://39.105.79.0
NEXT_PUBLIC_APP_URL=https://39.105.79.0
NEXT_PUBLIC_SITE_URL=https://39.105.79.0

# Keep this value stable when AUTH_COOKIE_SECRET is rotated so existing MCP
# tokens continue to verify.
WIKI_MCP_TOKEN_SECRET=CHANGE_ME_TO_THE_PREVIOUS_AUTH_COOKIE_SECRET
WIKI_MCP_PUBLIC_URL=https://39.105.79.0/mcp
WIKI_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,192.168.1.40:*,39.105.79.0,39.105.79.0:*,wiki-mcp:*
WIKI_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://192.168.1.40:*,https://39.105.79.0,https://39.105.79.0:*

WORKDAY_COLLECTOR_ENDPOINT=https://39.105.79.0
